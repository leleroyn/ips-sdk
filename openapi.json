    "/api/v2/handprint/detect": {
      "post": {
        "tags": ["手印检测"],
        "summary": "手印检测接口 v2",
        "description": "检测图片或 PDF 中是否存在手印",
        "operationId": "handprint_detect",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "图片或 PDF 文件"
                  },
                  "position": {
                    "type": "string",
                    "description": "位置信息"
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandprintResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v3/idcard/preprocess": {
      "post": {
        "tags": ["身份证检测-v3"],
        "summary": "身份证预处理接口 v3 (UploadFile)",
        "operationId": "idcard_preprocess_v3",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "return_corp_image": {
                    "type": "boolean",
                    "default": true
                  },
                  "return_ocr_text": {
                    "type": "boolean",
                    "default": false
                  },
                  "init_confidence": {
                    "type": "number",
                    "default": 0.5
                  },
                  "resize": {
                    "type": "boolean",
                    "default": true
                  },
                  "back_ground": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IdCardResult"
                  }
                }
              }
            }
          }
        }
      }
    },
