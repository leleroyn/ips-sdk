  "components": {
    "schemas": {
      "ToolConfig": {
        "type": "object",
        "properties": {
          "init_confidence": {
            "type": "number"
          },
          "resize": {
            "type": "boolean"
          },
          "back_ground": {
            "type": "boolean"
          }
        }
      },
      "IdCardRequest": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string"
          },
          "return_corp_image": {
            "type": "boolean"
          },
          "return_ocr_text": {
            "type": "boolean"
          },
          "tool": {
            "$ref": "#/components/schemas/ToolConfig"
          }
        }
      },
      "IdCardResult": {
        "type": "object",
        "properties": {
          "corp_image_base64": {
            "type": "string",
            "nullable": true
          },
          "confidence": {
            "type": "number"
          },
          "idcard_type": {
            "type": "integer"
          },
          "ocr_text": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "BizLicRequest": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string"
          },
          "return_corp_image": {
            "type": "boolean"
          },
          "return_ocr_text": {
            "type": "boolean"
          },
          "tool": {
            "$ref": "#/components/schemas/ToolConfig"
          }
        }
      },
      "BizLicResult": {
        "type": "object",
        "properties": {
          "corp_image_base64": {
            "type": "string",
            "nullable": true
          },
          "confidence": {
            "type": "number"
          },
          "bizlic_type": {
            "type": "integer"
          },
          "ocr_text": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SealRequest": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "return_seal_image": {
            "type": "boolean"
          },
          "return_ocr_text": {
            "type": "boolean"
          },
          "tool": {
            "$ref": "#/components/schemas/ToolConfig"
          }
        }
      },
      "SealResult": {
        "type": "object",
