            "type": "string",
            "nullable": true
          },
          "confidence": {
            "type": "number"
          },
          "seal_type": {
            "type": "integer"
          },
          "ocr_result": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CardRequest": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string"
          },
          "return_corp_image": {
            "type": "boolean"
          }
        }
      },
      "CardResult": {
        "type": "object",
        "properties": {
          "corp_image_base64": {
            "type": "string",
            "nullable": true
          },
          "card_info": {
            "$ref": "#/components/schemas/CardInfo"
          },
          "fork": {
            "type": "boolean"
          }
        }
      },
      "CardInfo": {
        "type": "object",
        "properties": {
          "card_type": {
            "type": "integer"
          },
          "confidence": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "InvoiceRequest": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "return_corp_image": {
            "type": "boolean"
          },
          "return_ocr_text": {
            "type": "boolean"
          },
          "tool": {
            "$ref": "#/components/schemas/ToolConfig"
          }
        }
      },
      "InvoiceResult": {
        "type": "object",
        "properties": {
          "corp_image_base64": {
            "type": "string",
            "nullable": true
          },
          "confidence": {
            "type": "number"
          },
          "invoice_type": {
            "type": "integer"
          },
          "ocr_text": {
            "type": "string",
            "nullable": true
          },
          "source_text": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "OcrRequest": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "return_image": {
            "type": "boolean"
          },
          "return_text": {
            "type": "boolean"
          }
        }
      },
      "OcrResult": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string",
            "nullable": true
          },
          "text": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "HandprintResult": {
        "type": "object",
        "properties": {
          "has_handprint": {
            "type": "boolean",
            "description": "是否存在手印"
          }
        }
      }
