    "/api/v1/idcard/preprocess": {
      "post": {
        "tags": ["身份证检测"],
        "summary": "身份证预处理接口",
        "operationId": "idcard_preprocess",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdCardRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IdCardResult"
                  }
                }
              }
            }
          }
        }
      }
    },
