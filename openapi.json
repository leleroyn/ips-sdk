{
  "openapi": "3.0.3",
  "info": {
    "title": "综合服务平台",
    "description": "提供OCR、证件检测、印章识别等AI能力的统一接口服务",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "本地服务器"
